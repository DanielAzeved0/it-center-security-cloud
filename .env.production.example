# Copy to .env.production on the production VM. Never commit the copied file.
APP_ENV=production
DOMAIN_NAME=monitor.example.com

# Use strong, unique values. Generate, for example: openssl rand -base64 32
POSTGRES_DB=it_center_security_cloud
POSTGRES_USER=itcenter
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://itcenter:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/it_center_security_cloud
AGENT_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY
AUTH_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_AUTH_TOKEN_SECRET
AUTH_TOKEN_EXPIRATION_MINUTES=60

# Used only by the frontend server-side proxy. It must remain internal.
ITCENTER_API_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Observability stack (node_exporter, cAdvisor, Prometheus, Grafana - EPIC 21,
# ADR-030). These 4 services live under `profiles: ["observability"]` in
# infra/docker-compose.production.yml and do NOT start with a normal
# `docker compose up`. Only set/uncomment before deliberately activating that
# profile, and only after validating available RAM/disk (ops-check.sh) on the
# 1GB Oracle Free Tier VM. Grafana itself is never exposed publicly; see
# docs/security/SECURITY.md and docs/architecture/NETWORK.md for the SSH
# tunnel access procedure.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
