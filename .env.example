APP_ENV=development
API_BASE_URL=http://localhost:8000/api/v1
ITCENTER_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

POSTGRES_DB=it_center_security_cloud
POSTGRES_USER=itcenter
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://itcenter:change-me@127.0.0.1:5432/it_center_security_cloud

AGENT_API_KEY=change-me
CHECKIN_INTERVAL_MINUTES=5

# Segredo usado para assinar (HMAC SHA-256) o Bearer token do login humano. Nunca reaproveitar AGENT_API_KEY.
AUTH_TOKEN_SECRET=change-me
# Validade do Bearer token, em minutos.
AUTH_TOKEN_EXPIRATION_MINUTES=60
