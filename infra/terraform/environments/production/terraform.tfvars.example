# Copiar para terraform.tfvars (nunca versionado, ver .gitignore) e preencher
# com os valores reais descobertos via oci CLI (ver infra/terraform/README.md,
# secao "Descoberta dos parametros reais").

tenancy_ocid      = "ocid1.tenancy.oc1..aaaaaaaa_EXEMPLO"
user_ocid         = "ocid1.user.oc1..aaaaaaaa_EXEMPLO"
fingerprint       = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path  = "/caminho/fora/do/repositorio/terraform-provisioner.pem"
region            = "sa-saopaulo-1"

compartment_id      = "ocid1.compartment.oc1..aaaaaaaa_EXEMPLO"
public_subnet_cidr  = "10.0.0.0/24"
private_subnet_cidr = "10.0.1.0/24"
# DNS labels sao imutaveis no OCI: usar o valor ja existente na subnet real
# (ver 'oci network subnet list'), nunca um nome so "bonito" novo.
public_subnet_dns_label  = "sub00000000000_EXEMPLO"
private_subnet_dns_label = "sub00000000001_EXEMPLO"

ingress_security_rules = [
  {
    protocol    = "6"
    source      = "0.0.0.0/0"
    description = "SSH"
    tcp_port    = 22
  },
  {
    protocol    = "6"
    source      = "0.0.0.0/0"
    description = "HTTP"
    tcp_port    = 80
  },
  {
    protocol    = "6"
    source      = "0.0.0.0/0"
    description = "HTTPS"
    tcp_port    = 443
  },
]

# Route table e security lists ja existentes usadas pela subnet privada
# (NAT Gateway + Service Gateway do VCN Wizard), descobertas via
# 'oci network route-table list' / 'oci network subnet list'. Fora do
# escopo do Terraform - so referenciadas, nunca gerenciadas.
private_route_table_id    = "ocid1.routetable.oc1..aaaaaaaa_EXEMPLO"
private_security_list_ids = ["ocid1.securitylist.oc1..aaaaaaaa_EXEMPLO"]

availability_domain = "abCD:SA-SAOPAULO-1-AD-1"
# Shapes fixos (ex.: VM.Standard.E2.1.Micro do Always Free) nao aceitam
# shape_config - deixar instance_shape_config = null nesse caso. So
# preencher shape_config para shapes flexiveis (ex.: VM.Standard.A1.Flex).
instance_shape        = "VM.Standard.E2.1.Micro"
instance_shape_config = null
instance_image_id            = "ocid1.image.oc1.sa-saopaulo-1.aaaaaaaa_EXEMPLO"
instance_ssh_authorized_keys = "ssh-rsa AAAA... exemplo@local"
